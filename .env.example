# Copy to .env (which is not committed) and fill in.

# Discord webhook upload.bat posts new builds to.
DISCORD_WEBHOOK=

# Backend (server/) Cube Watch connects to, fixed in the exe at build time.
# Leave empty to build a Cube Watch that does not connect anywhere.
#   127.0.0.1:8081           the backend itself (plain websocket)
#   cube.example.org         behind HTTPS (nginx, Caddy, ...): TLS, port 443
#   wss://cube.example.org   the same, spelled out (ws:// = without TLS, port 80)
REMOTE_ADDR=127.0.0.1:8081
# The backend's --client-key, when it has one.
REMOTE_KEY=
